@charset "gbk";

* { font-family: "Microsoft YaHei", SimSun, "Open Sans", Arial, Helvetica, sans-serif; }

label { font-weight: normal; font-size: 12px; }

#page-path label { font-weight: bold; }

.btn-group-xs > .btn, .btn-xs { font-family: SimSun, "Microsoft YaHei", "Open Sans", Arial, Helvetica, sans-serif; font-size: 13px; border-radius: 3px; }

.btn-primary, .btn-danger { color: rgb(23, 56, 84); background-color: rgb(255, 255, 255); border-color: rgb(44, 105, 157); }

button { padding: 2px 10px !important; vertical-align: inherit !important; }

form { margin: 0px; }

.form-control { padding: 3px 7px; }

.inline { display: inline-block; }

.block { display: block; margin: 2px; font-size: 16px; }

.margin-5 { margin: 5px; font-size: 16px; }

.margin-10 { margin: 10px; }

input[type="text"], input[type="email"], input[type="password"], select, input { height: 18px !important; }

input[type="button"] { height: 21px !important; }

.required::before { content: "*"; color: red; margin-right: 3px; }

.datalist { overflow: auto; width: 100%; }

.datalist table { border-top: 0px; border-left: 0px; border-right: 0px; }

.table_outer { position: relative; height: 100%; }

.table { font-size: 12px; white-space: nowrap; margin: 0px; table-layout: fixed; }

.table input[type="checkbox"], .table input[type="radio"] { margin: 0px; vertical-align: middle; display: inline; }

.table > tbody > tr > td, .table > tbody > tr > th, .table > tfoot > tr > td, .table > tfoot > tr > th { padding: 4px 5px; white-space: nowrap; text-overflow: ellipsis; overflow: hidden; word-break: break-all; }

.table > thead > tr > td, .table > thead > tr > th { padding: 4px 0px; }

.table thead { background: rgb(246, 247, 251); color: rgb(51, 51, 51); font-weight: bold; white-space: normal; }

.table thead tr td { vertical-align: middle; text-align: center; }

.dynamic-table thead { border-top: 1px solid rgb(221, 221, 221); }

.selectedblue { color: white; background-color: rgb(54, 138, 226) !important; }

.selectedblue a { color: blue; }

.selectedblue input, .selectedgreen input, .selectedpurple input, .selectedred input { color: rgb(51, 51, 51); }

.selectedblue select, .selectedgreen select, .selectedpurple select, .selectedred select { color: rgb(51, 51, 51); }

.selectedgreen { color: white; background-color: rgb(169, 212, 167) !important; }

.selectedgreen a { color: white; }

.selectedpurple { color: white; background-color: rgb(180, 156, 211) !important; }

.selectedpurple a { color: white; }

.selectedred { color: white; background-color: rgb(219, 88, 88) !important; }

.selectedred a { color: white; }

.selectedblack { color: rgb(255, 255, 255); background-color: rgb(42, 42, 42) !important; }

.selectedblack a { color: rgb(255, 255, 255); }

.selectedgray { color: rgb(255, 255, 255); background-color: rgb(140, 140, 140) !important; }

.selectedgray a { color: rgb(255, 255, 255); }

.fixedTable { position: absolute; top: 0px; left: 0px; }

.pagination-outer { background: rgb(247, 247, 247); position: absolute; bottom: 0px; border-top: 1px solid rgb(221, 221, 221); height: 30px; line-height: 30px; width: 100%; font-size: 12px !important; }

.table-page { overflow: hidden; background: rgb(247, 247, 247); height: 30px; line-height: 30px; padding: 0px 10px; border-width: 0px 1px 1px; border-style: none solid solid; border-color: currentcolor rgb(221, 221, 221) rgb(221, 221, 221); border-image: initial; }

.page-total, .page-list, .change-page > a { margin-right: 10px; }

.page-total span, .page-list span { color: red; }

.page-list span { margin: 0px 4px; }

.page-total { margin-right: 10px; }

.jump-page input { line-height: 20px; width: 40px; margin-left: 3px; margin-right: 3px; text-align: center; height: 20px !important; }

.area-operation { overflow: hidden; height: 45px; line-height: 45px; margin-bottom: 5px; padding: 0px 15px; border-bottom: 1px solid rgb(221, 221, 221); }

.query-input { width: auto; display: inline-block; }

.operation-btn button { margin-left: 5px; }

.operation-tip { margin-left: 40%; color: rgb(70, 141, 187); }

.operation-title { font-weight: bold; }

#dataTable { overflow: auto; height: 100%; width: 100%; }

.area-data { margin: 0px; border: 0px solid rgb(221, 221, 221); position: relative; overflow: hidden; }

.area-data table { border: 0px; }

.area-search { padding: 5px; margin: 5px; overflow: hidden; border: 1px solid rgb(221, 221, 221); }

.area-search .form-inline .form-group { margin-left: 15px; margin-bottom: 0px; }

.area-search .form-horizontal .form-group { margin-left: 15px; margin-bottom: 5px; }

.area-search .form-inline input, .area-search .form-inline select { width: auto; }

.area-search select { padding: 2px 10px; }

.area-setting { padding: 5px 5px 0px 0px; border: 1px solid rgb(221, 221, 221); overflow: hidden; margin: 0px 5px 5px; }

.area-setting label, .area-search label { white-space: nowrap; }

.area-setting .form-group > div { padding-left: 0px; }

.area-setting .form-group { margin-top: 5px; margin-bottom: 10px; }

.left-panel { float: left; width: 240px; border: 1px solid rgb(221, 221, 221); margin-left: 5px; overflow: auto; }

.right-panel { margin-left: 250px; margin-right: 5px; }

.menutree-top { border-bottom: 1px solid rgb(221, 221, 221); }

.menutree-top, .menutree-bottom { width: 100%; height: 50%; overflow: auto; }

.comdiv { position: absolute; width: 96%; height: 160px; border: 1px solid rgb(183, 183, 183); background-color: white; z-index: 1000; left: 0px; overflow-y: auto; }

.comdiv > div { padding: 0px 15px; }

.comdiv > div:hover { background: rgb(30, 144, 255); color: white; }

.popover { min-width: 190px; }

.popover-msg { line-height: 2em; }

.popover-title { color: rgb(36, 76, 103); font-weight: bold; font-size: 15px; }

.popover-title i { margin-right: 5px; }

.popover-btn button { margin-right: 15px; }

.popover-btn button i { margin-right: 5px; }

.open-menu { position: absolute; z-index: 99999; border: 1px solid rgb(204, 204, 204); background-color: white; }

.open-menu > div { border-bottom: 1px solid rgb(221, 221, 221); text-align: left; padding-left: 10px; height: 24px; line-height: 24px; }

.open-menu > div:hover { cursor: pointer; background: rgb(245, 222, 179); }

.open-menu > div:last-child { border-bottom-width: medium; border-bottom-style: none; border-bottom-color: currentcolor; }

.toast-title { font-weight: bold; }

.toast-message { overflow-wrap: break-word; }

.toast-message a, .toast-message label { color: rgb(255, 255, 255); }

.toast-message a:hover { color: rgb(204, 204, 204); text-decoration: none; }

.toast-close-button { position: relative; right: -0.3em; top: -0.3em; float: right; font-size: 20px; font-weight: bold; color: rgb(255, 255, 255); text-shadow: rgb(255, 255, 255) 0px 1px 0px; opacity: 0.8; }

.toast-close-button:hover, .toast-close-button:focus { color: rgb(0, 0, 0); text-decoration: none; cursor: pointer; opacity: 0.4; }

button.toast-close-button { padding: 0px; cursor: pointer; background: transparent; border: 0px; appearance: none; }

.toast-top-center { top: 0px; right: 0px; width: 100%; }

.toast-bottom-center { bottom: 0px; right: 0px; width: 100%; }

.toast-top-full-width { top: 0px; right: 0px; width: 100%; }

.toast-bottom-full-width { bottom: 0px; right: 0px; width: 100%; }

.toast-top-left { top: 12px; left: 12px; }

.toast-top-right { top: 12px; right: 12px; }

.toast-bottom-right { right: 12px; bottom: 12px; }

.toast-bottom-left { bottom: 12px; left: 12px; }

#toast-container { position: fixed; z-index: 999999; }

#toast-container * { box-sizing: border-box; }

#toast-container > div { margin: 0px 0px 6px; padding: 15px 15px 15px 50px; width: 300px; border-radius: 3px; background-position: 15px center; background-repeat: no-repeat; box-shadow: rgb(153, 153, 153) 0px 0px 12px; color: rgb(255, 255, 255); opacity: 0.8; }

#toast-container > :hover { box-shadow: rgb(0, 0, 0) 0px 0px 12px; opacity: 1; cursor: pointer; }

#toast-container > .toast-info { background-image: url("data:image/png;base64,") !important; }

#toast-container > .toast-error { background-image: url("data:image/png;base64,") !important; }

#toast-container > .toast-success { background-image: url("data:image/png;base64,") !important; }

#toast-container > .toast-warning { background-image: url("data:image/png;base64,") !important; }

#toast-container.toast-top-center > div, #toast-container.toast-bottom-center > div { width: 300px; margin: auto; }

#toast-container.toast-top-full-width > div, #toast-container.toast-bottom-full-width > div { width: 96%; margin: auto; }

.toast { background-color: rgb(3, 3, 3); }

.toast-success { background-color: rgb(81, 163, 81); }

.toast-error { background-color: rgb(189, 54, 47); }

.toast-info { background-color: rgb(47, 150, 180); }

.toast-warning { background-color: rgb(248, 148, 6); }

@media (max-width: 240px) {
  #toast-container > div { padding: 8px 8px 8px 50px; width: 11em; }
  #toast-container .toast-close-button { right: -0.2em; top: -0.2em; }
}

@media (min-width: 241px) and (max-width: 480px) {
  #toast-container > div { padding: 8px 8px 8px 50px; width: 18em; }
  #toast-container .toast-close-button { right: -0.2em; top: -0.2em; }
}

@media (min-width: 481px) and (max-width: 768px) {
  #toast-container > div { padding: 15px 15px 15px 50px; width: 25em; }
}

.select2-container--default .select2-selection--single { border-radius: 0px; }

.select2-container .select2-selection--single { height: 25px; }

.select2-container--default .select2-selection--single .select2-selection__rendered { line-height: 23px; }

#divTitle { float: left; text-indent: 6px; font-weight: bold; margin: 0px; }

#divTip { float: left; text-indent: 10px; text-align: center; color: red; margin: 0px; }

.nav-tabs > li.active > a { border-width: 1px 1px 0px; border-style: solid solid none; border-color: rgb(199, 199, 199) rgb(199, 199, 199) currentcolor; border-image: initial; }

.nav-tabs > li > a { color: rgb(0, 0, 0); cursor: pointer; }

.nav-tabs > li > a:hover { color: rgb(0, 0, 0); cursor: pointer; }

.nav-tabs > li > a:focus { color: rgb(0, 0, 0); cursor: pointer; }

.nav-tabs > li.active > a, .nav-tabs > li.active > a:focus, .nav-tabs > li.active > a:hover { color: rgb(0, 0, 0); font-weight: bold; }

iframe { border: 1px solid rgb(221, 221, 221); }

td p { margin: 0px !important; }

.status_new { color: rgb(54, 138, 226); }

.status_processing { color: rgb(0, 184, 63); }

.status_finished { color: rgb(213, 133, 18); }

.status_canceled { color: rgb(153, 153, 170); }
